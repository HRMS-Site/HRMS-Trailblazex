# Backend API base URL, including the version prefix if the backend uses one.
# Do not commit real hosts or secrets. Copy this file to .env.local.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Temporary frontend development data. Use "true" only while agreed API
# endpoints are unavailable. Set "false" to call the real backend.
# Failed live requests never fall back to mock data.
VITE_USE_MOCK_API=false
