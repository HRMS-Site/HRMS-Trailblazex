# Copy this file to .env and replace the placeholders.
# Never commit a real password.

# Option 1: full SQLAlchemy URL
DATABASE_URL=postgresql+psycopg2://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/hrms

# Option 2: individual fields (used only when DATABASE_URL is unset)
# POSTGRES_USER=YOUR_DB_USER
# POSTGRES_PASSWORD=YOUR_DB_PASSWORD
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=hrms
